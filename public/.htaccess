# Laravel production front controller. Configure Apache's DocumentRoot to this
# directory (the project's public/ directory), never to the project root.

<IfModule mod_negotiation.c>
    Options -MultiViews -Indexes
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Preserve authorization and CSRF headers for PHP/Laravel.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{HTTP:X-XSRF-TOKEN} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-TOKEN}]

    # Never serve hidden files (including VCS and environment files).
    RewriteRule (^|/)\. - [F,L]

    # Keep Apache from exposing common backup, configuration, or source files
    # accidentally copied into public/.
    RewriteRule \.(?:env|ini|log|bak|conf|dist|sql|sqlite|ya?ml|md|lock|phar|sh)$ - [F,NC,L]

    # Redirect trailing slashes on non-directories to one canonical URL.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} .+/$
    RewriteRule ^(.+?)/$ $1 [R=301,L,NE]

    # Serve existing public files directly; send all other requests to Laravel.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Baseline browser security headers. HSTS is intentionally managed by the
# HTTPS-terminating web server/proxy so it is only enabled on confirmed HTTPS.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always unset X-Powered-By
</IfModule>

# Compress text-based responses when mod_deflate is available.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache fingerprinted Vite assets for a year. Only filenames with an
# eight-character-or-longer hexadecimal fingerprint receive immutable caching.
<IfModule mod_headers.c>
    <FilesMatch "(?i)-[a-f0-9]{8,}\.(?:css|js|mjs|svg|png|jpe?g|gif|webp|avif|ico|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
